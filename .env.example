# Copiá este archivo a .env y completá los valores reales antes de desplegar a producción.
# Ninguna de estas variables es necesaria para desarrollar localmente (tienen valores por
# defecto de ejemplo definidos en el código).

# Dominio real del sitio, sin barra final. Se usa para generar URLs canónicas, el sitemap,
# Open Graph y los datos estructurados (JSON-LD).
SITE_URL=https://tda-argentina.example

# Dirección de correo real a la que deben llegar los mensajes de /contacto y /reportar-error.
PUBLIC_CONTACT_EMAIL=contacto@tda-argentina.example
