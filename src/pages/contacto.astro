---
import SiteLayout from '@/layouts/SiteLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import Button from '@/components/common/Button.astro';
import PageHeader from '@/components/common/PageHeader.astro';

// Definir PUBLIC_CONTACT_EMAIL en .env antes de desplegar a producción (ver .env.example).
const CONTACT_EMAIL = import.meta.env.PUBLIC_CONTACT_EMAIL ?? 'contacto@tda-argentina.example';
---

<SiteLayout title="Contacto" description="Cómo ponerte en contacto con el equipo de TDA Argentina." canonicalPath="/contacto">
  <Breadcrumbs items={[{ label: 'Contacto' }]} />
  <div class="container-page pb-16">
    <PageHeader icon="mail" title="Contacto">
      Si querés escribirnos por una consulta general, podés hacerlo por correo. Para errores puntuales en
      los datos, usá mejor la página
      <a href="/reportar-error" class="text-link underline underline-offset-2">Reportar un error</a>,
      así queda mejor organizado.
    </PageHeader>
    <Button href={`mailto:${CONTACT_EMAIL}`}>Escribirnos a {CONTACT_EMAIL}</Button>
    <p class="mt-6 max-w-xl text-xs text-text-secondary">
      Dato de ejemplo: esta dirección de correo es un placeholder del proyecto — reemplazala por la
      dirección real antes de publicar el sitio.
    </p>
  </div>
</SiteLayout>
