---
import SiteLayout from '@/layouts/SiteLayout.astro';
import GlobalSearch from '@/features/station-search/GlobalSearch';
import MapPreviewStatic from '@/components/stations/MapPreviewStatic.astro';
import NearbyStationsPreview from '@/features/map/NearbyStationsPreview';
import Card from '@/components/common/Card.astro';
import Button from '@/components/common/Button.astro';
import Icon, { type IconName } from '@/components/common/Icon.astro';
import { getAllStations } from '@/lib/data/stations';
import { getAllProvinces } from '@/lib/data/geo';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { organizationJsonLd } from '@/lib/seo/structuredData';
import { GUIDE_LEVEL_LABEL } from '@/types/guide';

const stations = await getAllStations();
const guides = (await getCollection('guides')).slice(0, 3);
const faqs = (await getCollection('faq')).slice(0, 4);
const provinces = getAllProvinces();
const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).toString();
const jsonLd = organizationJsonLd(siteUrl);

const stats = [
  { label: 'Estaciones cargadas', value: String(stations.length) },
  { label: 'Provincias mapeadas', value: String(provinces.length) },
  { label: 'Herramientas', value: '4' },
];

const howToItems: Array<{ icon: IconName; title: string; description: string; href: string }> = [
  {
    icon: 'broadcast',
    title: 'Cómo funciona la TDA',
    description:
      'Un sistema de televisión digital y gratuita basado en el estándar ISDB-T, con estaciones distribuidas en todo el país.',
    href: '/guias/que-es-la-tda',
  },
  {
    icon: 'pin',
    title: 'Cómo encontrar una estación',
    description: 'Buscá por localidad, provincia o código postal, o usá tu ubicación para ver qué tenés más cerca.',
    href: '/herramientas/estacion-mas-cercana',
  },
  {
    icon: 'sliders',
    title: 'Cómo elegir una antena',
    description: 'Interior o exterior, direccional o no: la elección depende de tu distancia y tu entorno.',
    href: '/preguntas-frecuentes',
  },
  {
    icon: 'activity',
    title: 'Problemas frecuentes',
    description: 'Pixelado, cortes o canales que desaparecen: cómo diagnosticarlos paso a paso.',
    href: '/herramientas/diagnostico',
  },
];

const tools: Array<{ icon: IconName; title: string; description: string; href: string }> = [
  { icon: 'pin', title: 'Estación más cercana', description: 'Distancia y señales disponibles.', href: '/herramientas/estacion-mas-cercana' },
  { icon: 'compass', title: 'Orientar antena', description: 'Azimut y punto cardinal.', href: '/herramientas/orientar-antena' },
  { icon: 'ruler', title: 'Calcular distancia', description: 'Origen a estación, en km.', href: '/herramientas/calcular-distancia' },
  { icon: 'activity', title: 'Diagnóstico', description: 'Pasos según tus síntomas.', href: '/herramientas/diagnostico' },
];
---

<SiteLayout
  title="TDA Argentina — Encontrá la señal de TDA más cercana"
  description="Consultá estaciones transmisoras, canales disponibles, cobertura estimada y la dirección correcta para orientar tu antena de Televisión Digital Abierta en Argentina."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  <section class="relative overflow-hidden border-b border-border bg-hero-glow">
    <div class="container-page grid gap-8 py-16 lg:grid-cols-2 lg:items-center lg:py-24">
      <div>
        <h1 class="text-5xl font-extrabold tracking-tight text-text-primary sm:text-6xl">
          Encontrá la señal de <span class="text-gradient-brand">TDA</span> más cercana
        </h1>
        <p class="mt-5 max-w-xl text-lg text-text-secondary">
          Consultá estaciones transmisoras, canales disponibles, cobertura estimada y la dirección correcta
          para orientar tu antena.
        </p>

        <div class="mt-7 max-w-md">
          <GlobalSearch client:load />
        </div>

        <div class="mt-5 flex flex-wrap gap-3">
          <Button href="/herramientas/estacion-mas-cercana" variant="primary">Buscar mi ubicación</Button>
          <Button href="/mapa" variant="secondary">Explorar el mapa</Button>
        </div>

        <dl class="mt-10 flex flex-wrap gap-x-8 gap-y-4 border-t border-border pt-6">
          {
            stats.map((stat) => (
              <div>
                <dt class="text-xs text-text-secondary">{stat.label}</dt>
                <dd class="font-mono text-2xl font-semibold text-text-primary">{stat.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="mx-auto aspect-[3/5] h-72 overflow-hidden rounded-xl border border-border shadow-[var(--shadow-soft)] lg:h-96">
        <MapPreviewStatic stations={stations} />
      </div>
    </div>
  </section>

  <section class="container-page py-12">
    <div class="mb-5 flex items-center justify-between">
      <h2 class="text-xl font-semibold text-text-primary">Estaciones cerca de vos</h2>
      <a href="/mapa" class="text-sm font-medium text-link hover:underline">Ver mapa completo →</a>
    </div>
    <NearbyStationsPreview client:visible stations={stations} />
  </section>

  <section class="border-t border-border bg-bg-secondary py-14">
    <div class="container-page">
      <h2 class="mb-8 text-xl font-semibold text-text-primary">Cómo empezar</h2>
      <div class="grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          howToItems.map((item, index) => (
            <a href={item.href} class="group block">
              <div class="mb-4 flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-500/10 text-brand-500 transition-colors group-hover:bg-brand-500 group-hover:text-white">
                  <Icon name={item.icon} size={18} />
                </span>
                <span class="font-mono text-xs text-text-secondary">{String(index + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="mb-1.5 font-semibold text-text-primary group-hover:text-link">{item.title}</h3>
              <p class="text-sm text-text-secondary">{item.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-page py-14">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-xl font-semibold text-text-primary">Guías destacadas</h2>
      <a href="/guias" class="text-sm font-medium text-link hover:underline">Ver todas las guías →</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-3">
      {
        guides.map((guide) => (
          <a href={`/guias/${guide.id}`} class="card-elevated block overflow-hidden p-0">
            <Image
              src={guide.data.heroImage}
              alt={guide.data.heroImageAlt}
              width={480}
              height={270}
              class="h-32 w-full object-cover"
            />
            <div class="p-5">
              <p class="mb-1.5 text-xs font-medium uppercase tracking-wide text-link">
                {GUIDE_LEVEL_LABEL[guide.data.level]}
              </p>
              <h3 class="mb-1.5 font-semibold text-text-primary">{guide.data.title}</h3>
              <p class="text-sm text-text-secondary">{guide.data.summary}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="border-t border-border bg-bg-secondary py-14">
    <div class="container-page">
      <h2 class="mb-8 text-xl font-semibold text-text-primary">Herramientas disponibles</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          tools.map((tool) => (
            <Card href={tool.href}>
              <span class="mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-brand-500/10 text-brand-500">
                <Icon name={tool.icon} size={18} />
              </span>
              <h3 class="mb-1 font-semibold text-text-primary">{tool.title}</h3>
              <p class="text-sm text-text-secondary">{tool.description}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-page py-14">
    <h2 class="mb-6 text-xl font-semibold text-text-primary">Preguntas frecuentes</h2>
    <div class="grid gap-3 sm:grid-cols-2">
      {
        faqs.map((faq) => (
          <details class="rounded-md border border-border p-4">
            <summary class="cursor-pointer font-medium text-text-primary">{faq.data.question}</summary>
            <p class="mt-2 text-sm text-text-secondary">{faq.data.answer}</p>
          </details>
        ))
      }
    </div>
    <a href="/preguntas-frecuentes" class="mt-4 inline-block text-sm font-medium text-link hover:underline">
      Ver todas las preguntas →
    </a>
  </section>
</SiteLayout>
