---
import SiteLayout from '@/layouts/SiteLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { techArticleJsonLd } from '@/lib/seo/structuredData';
import { GUIDE_LEVEL_LABEL } from '@/types/guide';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide, allGuides: guides },
  }));
}

const { guide, allGuides } = Astro.props;
const { Content } = await render(guide);

const related = guide.data.relatedGuides
  .map((slug: string) => allGuides.find((g) => g.id === slug))
  .filter((g): g is (typeof allGuides)[number] => g !== undefined);

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const jsonLd = techArticleJsonLd({
  title: guide.data.title,
  description: guide.data.summary,
  url: new URL(`/guias/${guide.id}`, siteUrl).toString(),
  datePublished: guide.data.updatedAt,
  dateModified: guide.data.updatedAt,
  author: guide.data.author,
});
---

<SiteLayout title={guide.data.title} description={guide.data.summary} canonicalPath={`/guias/${guide.id}`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  <Breadcrumbs items={[{ label: 'Guías', href: '/guias' }, { label: guide.data.title }]} />
  <header class="relative -mx-5 mb-8 overflow-hidden border-b border-border bg-hero-glow sm:mx-[calc(50%-50vw)]">
    <div class="container-page mx-auto max-w-2xl py-10 sm:py-12">
      <p class="mb-2 text-xs font-medium uppercase tracking-wide text-link">
        {GUIDE_LEVEL_LABEL[guide.data.level]} · {guide.data.readingTimeMinutes} min de lectura
      </p>
      <h1 class="mb-3 text-3xl font-extrabold tracking-tight text-gradient-brand sm:text-4xl">{guide.data.title}</h1>
      <p class="text-text-secondary">{guide.data.summary}</p>
      <p class="mt-3 text-xs text-text-secondary">
        Actualizado el <span class="font-mono">{guide.data.updatedAt}</span> · {guide.data.author}
      </p>
    </div>
  </header>

  <article class="container-page pb-16">
    <figure class="mx-auto mb-8 max-w-2xl">
      <Image
        src={guide.data.heroImage}
        alt={guide.data.heroImageAlt}
        width={800}
        height={600}
        class="h-auto max-h-[420px] w-full rounded-lg border border-border object-cover shadow-[var(--shadow-soft)]"
      />
      <figcaption class="mt-1.5 text-xs text-text-secondary">
        Foto:{' '}
        <a href={guide.data.heroImageCredit.sourceUrl} class="underline underline-offset-2 hover:text-link" target="_blank" rel="noreferrer">
          {guide.data.heroImageCredit.author}
        </a>{' '}
        ({guide.data.heroImageCredit.license}, vía Wikimedia Commons)
      </figcaption>
    </figure>

    <div class="prose-tda mx-auto">
      <Content />
    </div>

    {
      guide.data.sources.length > 0 && (
        <div class="mx-auto mt-10 max-w-2xl border-t border-border pt-6">
          <h2 class="mb-2 text-sm font-semibold text-text-primary">Fuentes</h2>
          <ul class="space-y-1 text-sm">
            {guide.data.sources.map((source: { name: string; url: string | null }) => (
              <li>
                {source.url ? (
                  <a href={source.url} class="text-link underline underline-offset-2" target="_blank" rel="noreferrer">
                    {source.name}
                  </a>
                ) : (
                  <span class="text-text-secondary">{source.name}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      related.length > 0 && (
        <div class="mx-auto mt-10 max-w-2xl border-t border-border pt-6">
          <h2 class="mb-3 text-sm font-semibold text-text-primary">Contenido relacionado</h2>
          <ul class="space-y-2">
            {related.map((item) => (
              <li>
                <a href={`/guias/${item.id}`} class="text-sm font-medium text-link hover:underline">
                  {item.data.title} →
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </article>
</SiteLayout>
