---
interface Props {
  variant?: 'info' | 'warning' | 'danger' | 'demo';
  title?: string;
  class?: string;
}

const { variant = 'info', title, class: className = '' } = Astro.props;

const styles = {
  info: 'bg-brand-50 border-brand-500/30 text-text-primary',
  warning: 'bg-status-warn-bg border-status-warn/40 text-text-primary',
  danger: 'bg-status-bad-bg border-status-bad/40 text-text-primary',
  demo: 'bg-status-warn-bg border-status-warn/50 text-text-primary',
};
---

<div role="note" class={`rounded-md border px-4 py-3 text-sm ${styles[variant]} ${className}`}>
  {title && <p class="mb-1 font-semibold">{title}</p>}
  <div class="text-text-secondary">
    <slot />
  </div>
</div>
