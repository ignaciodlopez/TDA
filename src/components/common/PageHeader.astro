---
import Icon, { type IconName } from '@/components/common/Icon.astro';

interface Props {
  icon: IconName;
  title: string;
}

const { icon, title } = Astro.props;
const hasDescription = Astro.slots.has('default');
---

<section class="relative -mx-5 mb-8 overflow-hidden border-b border-border bg-hero-glow sm:mx-[calc(50%-50vw)]">
  <div class="container-page flex items-start gap-4 py-10 sm:py-12">
    <span class="mt-1 flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-500/10 text-brand-500">
      <Icon name={icon} size={24} />
    </span>
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-gradient-brand sm:text-4xl">{title}</h1>
      {
        hasDescription && (
          <div class="mt-2 max-w-2xl text-text-secondary">
            <slot />
          </div>
        )
      }
    </div>
  </div>
</section>
