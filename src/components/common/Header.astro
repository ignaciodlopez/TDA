---
import GlobalSearch from '@/features/station-search/GlobalSearch';
import ThemeToggle from '@/components/common/ThemeToggle.astro';

const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Mapa', href: '/mapa' },
  { label: 'Estaciones', href: '/estaciones' },
  { label: 'Canales', href: '/canales' },
  { label: 'Guías', href: '/guias' },
  { label: 'Herramientas', href: '/herramientas' },
  { label: 'Recursos', href: '/recursos' },
  { label: 'Preguntas', href: '/preguntas-frecuentes' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-30 border-b border-border bg-bg-primary/90 backdrop-blur">
  <div class="container-page flex h-16 items-center gap-4">
    <a href="/" aria-label="TDA Argentina — Inicio" class="flex shrink-0 items-center gap-2 font-semibold text-text-primary">
      <span
        class="flex h-8 w-8 items-center justify-center rounded-md bg-brand-500 text-sm font-bold text-white"
        aria-hidden="true">TDA</span
      >
      <span class="hidden sm:inline">TDA Argentina</span>
    </a>

    <nav aria-label="Navegación principal" class="hidden flex-1 items-center gap-1 lg:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={currentPath === item.href ? 'page' : undefined}
            class={`shrink-0 whitespace-nowrap rounded-md px-3 py-2 text-sm font-medium transition-colors ${
              currentPath === item.href
                ? 'text-link'
                : 'text-text-secondary hover:text-text-primary'
            }`}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden max-w-xs flex-1 md:block">
      <GlobalSearch client:load />
    </div>

    <div class="ml-auto flex shrink-0 items-center gap-1">
      <ThemeToggle />

      <button
        id="mobile-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación"
        class="rounded-md p-2 text-text-secondary hover:bg-surface lg:hidden"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-border lg:hidden">
    <div class="container-page space-y-3 py-4">
      <div class="md:hidden">
        <GlobalSearch client:load />
      </div>
      <nav aria-label="Navegación móvil" class="flex flex-col gap-1">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={currentPath === item.href ? 'page' : undefined}
              class={`rounded-md px-3 py-2.5 text-base font-medium ${
                currentPath === item.href ? 'text-link' : 'text-text-primary'
              }`}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;
    toggle.addEventListener('click', function () {
      const isOpen = menu.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
    });
  })();
</script>
