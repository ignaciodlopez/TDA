---
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Cambiar entre modo claro y oscuro"
  class="rounded-md p-2 text-text-secondary hover:bg-surface hover:text-text-primary"
>
  <svg
    id="theme-toggle-icon-light"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    class="h-5 w-5"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <svg
    id="theme-toggle-icon-dark"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    class="hidden h-5 w-5"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    function applyIcons(theme) {
      const light = document.getElementById('theme-toggle-icon-light');
      const dark = document.getElementById('theme-toggle-icon-dark');
      if (!light || !dark) return;
      light.classList.toggle('hidden', theme === 'dark');
      dark.classList.toggle('hidden', theme !== 'dark');
    }

    const current = document.documentElement.getAttribute('data-theme') || 'light';
    applyIcons(current);

    const button = document.getElementById('theme-toggle');
    if (button) {
      button.addEventListener('click', function () {
        const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try {
          localStorage.setItem('tda-theme', next);
        } catch {
          // localStorage no disponible (modo privado); el tema no persiste entre sesiones.
        }
        applyIcons(next);
      });
    }
  })();
</script>
