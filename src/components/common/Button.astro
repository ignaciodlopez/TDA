---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
}

const { variant = 'primary', size = 'md', href, type = 'button', class: className = '' } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-md font-medium transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 disabled:opacity-50 disabled:pointer-events-none motion-reduce:transition-none';

const variants = {
  primary:
    'bg-brand-500 text-white shadow-[var(--shadow-glow-brand)] hover:bg-brand-600 hover:-translate-y-px active:translate-y-0 active:bg-brand-700 motion-reduce:hover:translate-y-0',
  secondary:
    'bg-surface text-text-primary border border-border hover:border-brand-500 hover:text-link',
  ghost: 'text-text-secondary hover:text-text-primary hover:bg-surface',
};

const sizes = {
  sm: 'px-3 py-1.5 text-sm',
  md: 'px-4 py-2.5 text-sm',
};

const classes = [base, variants[variant], sizes[size], className].join(' ');
const Tag = href ? 'a' : 'button';
---

<Tag class={classes} href={href} type={href ? undefined : type}>
  <slot />
</Tag>
